PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/learneasepro
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
# Optional SMTP settings for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LearnEase Pro <no-reply@example.com>

# Cloudinary file storage (required for video, thumbnail and resource uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe payments (required only for paid courses)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=gbp
JWT_EXPIRES_IN=7d
